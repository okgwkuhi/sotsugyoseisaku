<h1>募集詳細</h1>

<div class="post-detail">
  <p><strong><%= @post.title %></strong></p>
  <p>
    <%= @post.event_at.strftime("%-m/%-d(%a) %H:%M〜") %>
    ・<%= @post.area %>
    ・<%= @post.style %>
  </p>
  <p>対象レベル:<%= @post.level %></p>
  <p>募集人数:<%= @post.capacity %>人</p>

  <% if @post.description.present? %>
    <p><%= simple_format(@post.description) %></p>
  <% end %>

  <p>主催者:<%= @post.user.name %>(<%= @post.user.level %>・<%= @post.user.style %>)</p>

  <% my_application = user_signed_in? ? @post.applications.find_by(user: current_user) : nil %>
  <% is_eligible = user_signed_in? && @post.organizer_id_or_approved_applicant?(current_user.id) %>

  <% if is_eligible %>
    <p class="meeting-place">
      詳細な場所:<%= @post.meeting_place.presence || "未設定" %>
    </p>
  <% end %>
</div>

<% if user_signed_in? %>
  <% if @post.organizer?(current_user) %>
    <p>
      <%= link_to "編集する", edit_post_path(@post) %>
      <%= button_to "削除する", post_path(@post), method: :delete,
            form: { data: { turbo_confirm: "本当にこの募集を削除しますか?" } } %>
      <%= link_to "応募者一覧を見る", post_applications_path(@post) %>
    </p>
  <% else %>
    <% if my_application %>
      <p>応募済みです(ステータス:<%= my_application.status_label %>)</p>
    <% elsif @post.full? %>
      <p>この募集は定員に達しました。</p>
    <% else %>
      <%= link_to "応募する", new_post_application_path(@post) %>
    <% end %>

    <p><%= link_to "この主催者を通報する", new_report_path(reported_user_id: @post.user_id, post_id: @post.id) %></p>
  <% end %>

  <% if is_eligible && @post.event_at <= Time.current %>
    <p><%= link_to "また遊びたいか回答する", new_post_want_again_response_path(@post) %></p>
  <% end %>
<% else %>
  <%= link_to "応募するにはログインしてください", new_user_session_path %>
<% end %>

<%= link_to "一覧へ戻る", posts_path %>
